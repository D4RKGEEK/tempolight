{
  "name": "tempolight",
  "version": "0.3.0",
  "description": "Music-reactive lighting for WLED that understands the song: beats, build-ups, drops and mood.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/D4RKGEEK/tempolight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D4RKGEEK/tempolight.git"
  },
  "bugs": "https://github.com/D4RKGEEK/tempolight/issues",
  "keywords": [
    "wled",
    "led",
    "music",
    "beat-detection",
    "lighting",
    "ddp",
    "e131",
    "hue",
    "dmx"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tempolight": "packages/server/src/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages/*/package.json",
    "packages/engine/src",
    "packages/outputs/src",
    "packages/server/src",
    "apps",
    "scripts/fake-wled.js",
    "!**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node packages/server/src/index.js --open",
    "serve": "node packages/server/src/index.js",
    "demo": "node scripts/demo.js",
    "fake-wled": "node scripts/fake-wled.js",
    "test": "node --test",
    "eval:beat": "node scripts/beat-eval.js",
    "eval:feel": "node scripts/feel-eval.js",
    "docs": "node scripts/gen-docs.js",
    "docs:check": "node scripts/check-docs.js",
    "docs:dev": "npm --prefix website install && npm --prefix website run dev",
    "docs:build": "npm --prefix website install && npm --prefix website run build",
    "test:browser": "node scripts/e2e-browser.js",
    "site": "node scripts/build-site.js",
    "test:demo": "node scripts/e2e-demo.js",
    "docs:site": "node scripts/build-docs-site.js --serve",
    "test:docs": "node scripts/e2e-docs.js",
    "bundle": "node scripts/bundle.js",
    "build:sea": "node scripts/build-sea.js --smoke",
    "smoke": "node scripts/smoke.js node packages/server/src/index.js",
    "test:firmware": "bash firmware/test/run.sh",
    "streamdeck": "node scripts/package-streamdeck.js"
  }
}
